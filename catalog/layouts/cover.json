{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "cover",
  "name": "Cover",
  "summary": "The opening slide: title, subtitle and an optional picture.",
  "tags": [
    "Openers and closers"
  ],
  "design": {
    "titleAlignment": "center",
    "contentAlignment": "center"
  },
  "areas": [
    "title media"
  ],
  "columns": [
    1,
    1
  ],
  "rows": [
    1
  ],
  "regions": {
    "media": {
      "accepts": [
        "image",
        "video"
      ],
      "role": "media",
      "flow": "none",
      "bleed": true
    }
  }
}
