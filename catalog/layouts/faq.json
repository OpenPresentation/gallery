{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "faq",
  "name": "FAQ",
  "summary": "Questions with their answers.",
  "tags": [
    "Groups of items"
  ],
  "design": {
    "contentBox": true
  },
  "areas": [
    "title",
    "questions"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "questions": {
      "accepts": [
        "list",
        "text",
        "group"
      ],
      "role": "primary",
      "flow": "column",
      "listColumns": "auto"
    }
  }
}
