{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "logos",
  "name": "Logos",
  "summary": "Customer, partner or sponsor logos in a grid of up to 12.",
  "tags": [
    "Mixed"
  ],
  "areas": [
    "title",
    "logos"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "logos": {
      "accepts": [
        "image",
        "text",
        "group"
      ],
      "role": "media",
      "flow": "grid",
      "max": 12
    }
  }
}
