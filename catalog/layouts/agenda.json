{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "agenda",
  "name": "Agenda",
  "summary": "What the talk covers: the parts, as one list that flows into columns when long.",
  "tags": [
    "Openers and closers"
  ],
  "areas": [
    "title",
    "items"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "items": {
      "accepts": [
        "list",
        "text"
      ],
      "role": "primary",
      "flow": "column",
      "listColumns": "auto"
    }
  }
}
