{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "two-column",
  "name": "Two columns",
  "summary": "Two independent columns of any content.",
  "tags": [
    "Text"
  ],
  "areas": [
    "title title",
    "first second"
  ],
  "columns": [
    1,
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "first": {
      "accepts": [
        "text",
        "list",
        "quote",
        "code",
        "image",
        "video",
        "chart",
        "table",
        "metric",
        "group"
      ],
      "role": "primary",
      "flow": "none"
    },
    "second": {
      "accepts": [
        "text",
        "list",
        "quote",
        "code",
        "image",
        "video",
        "chart",
        "table",
        "metric",
        "group"
      ],
      "role": "primary",
      "flow": "none"
    }
  }
}
