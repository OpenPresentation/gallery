{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "image",
  "name": "Image",
  "summary": "One picture edge to edge under an optional title.",
  "tags": [
    "Visuals"
  ],
  "areas": [
    "title",
    "media"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "media": {
      "accepts": [
        "image",
        "video"
      ],
      "role": "media",
      "flow": "none",
      "bleed": true
    }
  }
}
