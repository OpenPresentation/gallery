{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "dashboard",
  "name": "Dashboard",
  "summary": "Headline numbers over charts.",
  "tags": [
    "Mixed"
  ],
  "design": {
    "contentBox": true
  },
  "areas": [
    "title",
    "kpis",
    "charts"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    2,
    3
  ],
  "regions": {
    "kpis": {
      "accepts": [
        "metric"
      ],
      "role": "secondary",
      "flow": "grid"
    },
    "charts": {
      "accepts": [
        "chart",
        "table"
      ],
      "role": "primary",
      "flow": "grid"
    }
  }
}
