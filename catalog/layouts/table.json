{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "table",
  "name": "Table",
  "summary": "A table across the slide, with an optional note.",
  "tags": [
    "Visuals"
  ],
  "areas": [
    "title",
    "table",
    "note"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1,
    "auto"
  ],
  "regions": {
    "table": {
      "accepts": [
        "table"
      ],
      "role": "primary",
      "flow": "column"
    },
    "note": {
      "accepts": [
        "text"
      ],
      "role": "supporting",
      "flow": "none"
    }
  }
}
