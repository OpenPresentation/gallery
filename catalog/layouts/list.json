{
  "$schema": "https://openpresentation.org/schema/opf-layout/v2",
  "id": "list",
  "name": "List",
  "summary": "Bulleted or numbered points; one long list flows into columns.",
  "tags": [
    "Text"
  ],
  "areas": [
    "title",
    "body"
  ],
  "columns": [
    1
  ],
  "rows": [
    "auto",
    1
  ],
  "regions": {
    "body": {
      "accepts": [
        "list",
        "text",
        "group"
      ],
      "role": "primary",
      "flow": "auto",
      "listColumns": "auto"
    }
  }
}
